source "https://rubygems.org"

# The same gems and versions GitHub Pages uses to build this site,
# so a local build matches what goes live.
gem "github-pages", group: :jekyll_plugins

# Needed to run `jekyll serve` on Ruby 3 and newer.
gem "webrick", "~> 1.8"

group :development do
  # Checks every internal link and image: bundle exec htmlproofer ./_site
  gem "html-proofer", "~> 5.0"
end
