# Jekyll build output and caches
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby gems installed locally (bundle config set --local path vendor/bundle)
.bundle/
vendor/
# Generated by `bundle install`; GitHub Pages always builds with the latest
# github-pages gem, so we don't pin versions here.
Gemfile.lock

# Node (not used by the site)
node_modules/

# Editors and OS files
.DS_Store
.replit
